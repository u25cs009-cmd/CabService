# Server Environment Configuration Template

# Server Port (default 5000)
PORT=5000

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# MongoDB Connection URI (MongoDB Atlas or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pipippip_cabs?retryWrites=true&w=majority

# JWT Secret for Session & Auth Token Generation (Must be at least 32 characters in production)
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars_here

# Frontend Application Origin URL (For CORS and redirect URLs)
CLIENT_URL=http://localhost:5173

# Google Maps API Key for Server-side Route & Distance calculations
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key

# Email Service Configuration (Nodemailer SMTP / Gmail App Password)
EMAIL_USER=your_email_username@domain.com
EMAIL_PASS=your_email_app_password
OWNER_EMAIL=your_owner_alert_email@domain.com

# Initial Admin Credentials (used by npm run seed)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional: Meta WhatsApp Cloud API Credentials
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Optional: SMS Gateway Adapter Credentials
SMS_API_KEY=your_sms_gateway_api_key
SMS_GATEWAY_URL=https://api.your-sms-provider.com/v1/send


